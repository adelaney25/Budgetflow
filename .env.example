# Copy this file to .env.local and fill in your values from the Supabase
# dashboard (Connect button, or Project Settings -> API Keys).
# .env.local is ignored by git, so your real values are never committed.
#
# Both values below are public (safe in the browser). NEVER add a secret /
# service_role key with a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
